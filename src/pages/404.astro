---
export const prerender = true;

import '../styles/global.css';
import { CookieBanner } from '../components/CookieBanner';
import Analytics from '../components/Analytics.astro';

const baseUrl = 'https://olovetools.com';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 - Page Not Found | oLoveTools</title>
    <meta name="description" content="The page you are looking for does not exist." />
    <meta name="theme-color" content="#060609" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style is:global>
      body {
        margin: 0;
        background-color: #060609;
        color: #f8fafc;
        font-family: 'Inter', sans-serif;
      }
      h1 { font-family: 'Outfit', sans-serif; }
    </style>
    <meta name="google-adsense-account" content="ca-pub-4601581729676999">
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4601581729676999"
     crossorigin="anonymous"></script>
    <Analytics />
  </head>
  <body class="min-h-screen flex flex-col items-center justify-center relative overflow-hidden bg-[#060609]">
    
    <!-- Efecto Glow de fondo corporativo -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[300px] h-[300px] md:w-[600px] md:h-[600px] bg-indigo-600/10 rounded-full blur-[100px] pointer-events-none"></div>

    <div class="text-center z-10 px-6">
      <div class="inline-block px-4 py-1.5 rounded-full bg-slate-800/60 border border-slate-700/50 text-indigo-400 text-sm font-semibold tracking-wide mb-6">
        ERROR 404
      </div>
      
      <h1 id="e404-oops" class="text-7xl md:text-9xl font-bold tracking-tight bg-clip-text text-transparent bg-gradient-to-br from-white to-slate-500 mb-6 drop-shadow-sm">
        Oops!
      </h1>
      
      <p id="e404-msg" class="text-lg md:text-2xl text-slate-400 max-w-lg mx-auto mb-10 font-normal leading-relaxed">
        It seems you've wandered into the web's void. This link is broken or the page no longer exists.
      </p>

      <div class="flex justify-center">
        <a id="e404-link" href="/" class="group inline-flex items-center gap-3 bg-indigo-500/10 border border-indigo-500/30 hover:bg-indigo-600 hover:border-indigo-600 text-indigo-300 hover:text-white px-8 py-4 rounded-full font-semibold transition-all duration-300 hover:scale-105 hover:shadow-[0_0_30px_rgba(99,102,241,0.3)]">
          <svg class="transition-transform group-hover:-translate-x-1" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="m12 19-7-7 7-7"/>
            <path d="M19 12H5"/>
          </svg>
          <span id="e404-btn">Return to oLoveTools Hub</span>
        </a>
      </div>
    </div>

    <script is:inline>
      (function () {
        var T = {
          en: { oops: "Oops!", msg: "It seems you've wandered into the web's void. This link is broken or the page no longer exists.", btn: "Return to oLoveTools Hub" },
          es: { oops: "¡Vaya!", msg: "Parece que te has perdido en el vacío de la web. Este enlace está roto o la página ya no existe.", btn: "Volver al inicio de oLoveTools" },
          fr: { oops: "Oups !", msg: "Il semble que vous vous soyez perdu dans le vide du web. Ce lien est rompu ou la page n'existe plus.", btn: "Retour à oLoveTools" },
          de: { oops: "Hoppla!", msg: "Es scheint, du hast dich in der Leere des Webs verirrt. Dieser Link ist defekt oder die Seite existiert nicht mehr.", btn: "Zurück zu oLoveTools" },
          pt: { oops: "Ops!", msg: "Parece que você se perdeu no vazio da web. Este link está quebrado ou a página não existe mais.", btn: "Voltar ao início do oLoveTools" },
          ru: { oops: "Упс!", msg: "Похоже, вы заблудились в пустоте сети. Эта ссылка не работает или страница больше не существует.", btn: "Вернуться на oLoveTools" },
          hi: { oops: "ओह!", msg: "लगता है आप वेब के शून्य में भटक गए हैं। यह लिंक टूटा है या पेज अब मौजूद नहीं है।", btn: "oLoveTools पर वापस जाएँ" },
          ja: { oops: "おっと！", msg: "ウェブの空白に迷い込んだようです。このリンクは壊れているか、ページはもう存在しません。", btn: "oLoveTools に戻る" },
          zh: { oops: "哎呀！", msg: "看来你迷失在网络的虚空中了。此链接已失效或页面不存在。", btn: "返回 oLoveTools 首页" }
        };
        var langs = ['en', 'es', 'fr', 'de', 'pt', 'ru', 'hi', 'ja', 'zh'];
        var seg = location.pathname.split('/').filter(Boolean)[0];
        var lang = langs.indexOf(seg) !== -1 ? seg : null;
        if (!lang) { try { var s = localStorage.getItem('olovetools_lang'); if (s && langs.indexOf(s) !== -1) lang = s; } catch (e) {} }
        if (!lang) { var b = (navigator.language || 'en').slice(0, 2).toLowerCase(); lang = langs.indexOf(b) !== -1 ? b : 'en'; }
        var t = T[lang] || T.en;
        var o = document.getElementById('e404-oops'); if (o) o.textContent = t.oops;
        var m = document.getElementById('e404-msg'); if (m) m.textContent = t.msg;
        var btn = document.getElementById('e404-btn'); if (btn) btn.textContent = t.btn;
        var link = document.getElementById('e404-link'); if (link) link.setAttribute('href', '/' + lang);
        document.documentElement.lang = lang;
        document.title = '404 · ' + t.oops + ' | oLoveTools';
      })();
    </script>
    <CookieBanner lang="en" client:load />
  </body>
</html>

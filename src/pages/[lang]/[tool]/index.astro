        {tool === 'subtitles-bolt' && <SubtitlesBolt lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool === 'passbolt' && <Passbolt lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool === 'whois-bolt' && <WhoisBolt lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool === 'framesnap' && <Framesnap lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool === 'cleansnap' && <Cleansnap lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool === 'klipy' && <Klipy lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool === 'clip-flow' && <ClipFlow lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool === 'jwt-bolt' && <JwtBolt lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool === 'qr-reader' && <QrReader lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool !== 'clipy' && tool !== 'twitchbolt' && tool !== 'kickbolt' && tool !== 'formatflow' && tool !== 'pastesnap' && tool !== 'compresssnap' && tool !== 'backgroundremover' && tool !== 'pdf-flow' && tool !== 'recordsnap' && tool !== 'qr-bolt' && tool !== 'codecard' && tool !== 'cropsnap' && tool !== 'css-designer' && tool !== 'json-flow' && tool !== 'socialbolt' && tool !== 'tts-bolt' && tool !== 'gif-bolt' && tool !== 'audiosnap' && tool !== 'drawsnap' && tool !== 'diffsnap' && tool !== 'watermark-snap' && tool !== 'favicon-bolt' && tool !== 'exif-clear' && tool !== 'meme-bolt' && tool !== 'wordflow' && tool !== 'markdown-live' && tool !== 'hash-bolt' && tool !== 'zip-flow' && tool !== 'regex-flow' && tool !== 'lottie-viewer' && tool !== 'svg-optimizer' && tool !== 'graph-flow' && tool !== 'url-bolt' && tool !== 'base64-bolt' && tool !== 'uuid-generator' && tool !== 'list-mixer' && tool !== 'html-sanitizer' && tool !== 'colorsnap' && tool !== 'hex-to-rgb' && tool !== 'aspect-ratio' && tool !== 'unitflow' && tool !== 'sql-flow' && tool !== 'cron-flow' && tool !== 'xml-json' && tool !== 'binary-flow' && tool !== 'morse-flow' && tool !== 'epoch-flow' && tool !== 'time-bolt' && tool !== 'device-test' && tool !== 'lorem-flow' && tool !== 'key-doctor' && tool !== 'whiteboard-flow' && tool !== 'subtitles-bolt' && tool !== 'passbolt' && tool !== 'whois-bolt' && tool !== 'framesnap' && tool !== 'cleansnap' && tool !== 'klipy' && tool !== 'clip-flow' && tool !== 'jwt-bolt' && tool !== 'qr-reader' && (
          <div class="min-h-screen bg-[#060609] text-slate-200 font-sans">
             <ToolPlaceholder lang={castLang} toolSlug={tool!} client:load />
          </div>
        )}
    </div>

    {/* El timeout no es cosmético: `client:idle` a secas espera un hueco de
        requestIdleCallback que en herramientas pesadas (Clipy con su barrido de
        clips) no llega NUNCA, y las islas de anuncios se quedaban sin hidratar
        para siempre. Por eso no se veían los raíles laterales. Con timeout se
        hidratan igual de tarde, pero se hidratan. */}
    <AdRail slug={tool!} client:idle={{ timeout: 2000 }} />
    <AdSlot position="anchor" size="mobile-banner" client:idle={{ timeout: 2000 }} />

    {toolCtas.length > 0 && (
      <section aria-label={ctaHeading} class="tool-ctas max-w-5xl mx-auto px-4 pt-10 pb-2">
        <p class="text-[11px] font-black uppercase tracking-[0.25em] text-slate-500 mb-3">{ctaHeading}</p>
        <div class="flex flex-wrap gap-3">
          {toolCtas.map((cta) => (
            <a
              href={`/${castLang}/${cta.target}/`}
              class="group inline-flex items-center gap-2 px-5 py-3 rounded-2xl text-sm font-bold text-white bg-gradient-to-r from-indigo-600/80 to-violet-600/80 border border-indigo-400/20 shadow-lg shadow-indigo-950/40 hover:from-indigo-500 hover:to-violet-500 transition-all"
            >
              <span>{cta.labels[castLang] || cta.labels.en}</span>
              <span class="text-indigo-200/80 text-xs font-black">{toolNames[cta.target] || cta.target}</span>
              <svg class="w-4 h-4 opacity-70 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          ))}
        </div>
      </section>
    )}

    {relatedSlugs.length > 0 && (
      <nav aria-label={relatedHeading} class="related-tools max-w-5xl mx-auto px-4 py-10 border-t border-white/5">
        <h2 class="text-lg font-black text-white mb-4 tracking-tight">{relatedHeading}</h2>
        <ul class="flex flex-wrap gap-3 list-none p-0 m-0">
          {relatedSlugs.map((slug) => (
            <li>
              <a
                href={`/${castLang}/${slug}/`}
                class="inline-flex items-center px-4 py-2 rounded-xl text-sm font-bold text-slate-300 bg-white/[0.03] border border-white/10 hover:border-indigo-500/40 hover:text-white transition-colors"
              >
                {toolNames[slug] || slug}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    {/* Unidad in-content responsive central: cubre las 60 herramientas (incl. las que
        no tienen AdBanner propio) sin editar cada una. Oculta en prod sin slot configurado. */}
    <div class="max-w-3xl mx-auto px-4 pb-4">
      <AdSlot position="content" size="leaderboard" client:idle={{ timeout: 2000 }} />
    </div>

    <!-- SSR SEO content: visible (not display:none) to avoid cloaking. Some tools already
         show similar content in their own footer; this is intentionally supplementary,
         not hidden duplicate text, so it carries no cloaking/penalty risk. -->
    <div class="max-w-5xl mx-auto px-4 py-12 grid grid-cols-1 lg:grid-cols-[1fr_300px] gap-8">
      <section class="ssr-seo-content text-slate-300">
        <h1 class="text-2xl md:text-3xl font-black text-white mb-4">{finalTitle}</h1>
        <p class="text-sm leading-relaxed text-slate-400 mb-8">{t('seo_description')}</p>

        {/* dictionary.xxx (no t()) porque t() devuelve el nombre de la clave si falta,
            lo que rompería este chequeo de existencia (siempre truthy) */}
        {(dictionary as any)?.footer_seo_title && <h2 class="text-xl font-bold text-white mt-8 mb-2">{(dictionary as any).footer_seo_title}</h2>}
        {(dictionary as any)?.footer_seo_paragraph1 && <p class="text-sm leading-relaxed text-slate-400 mb-3">{(dictionary as any).footer_seo_paragraph1}</p>}
        {(dictionary as any)?.footer_seo_paragraph2 && <p class="text-sm leading-relaxed text-slate-400 mb-3">{(dictionary as any).footer_seo_paragraph2}</p>}
        {(dictionary as any)?.footer_seo_desc_large && <p class="text-sm leading-relaxed text-slate-400 mb-3">{(dictionary as any).footer_seo_desc_large}</p>}

        {/* Solo intentar mapear si t.faq es realmente un array */}
        {Array.isArray(t.faq) && (
          <>
            <h2 class="text-xl font-bold text-white mt-8 mb-3">{(dictionary as any)?.faqTitle || 'FAQ'}</h2>
            {t.faq.map((item: any) => (
              <div class="mb-4">
                <h3 class="text-base font-bold text-white mb-1">{item.question}</h3>
                <p class="text-sm leading-relaxed text-slate-400">{item.answer}</p>
              </div>
            ))}
          </>
        )}

        {/* Solo intentar unir si t.seoKeywords es realmente un array */}
        {Array.isArray(t.seoKeywords) && (
          <>
            <h2 class="text-xl font-bold text-white mt-8 mb-2">{(dictionary as any)?.seoKeywordsTitle || 'Keywords'}</h2>
            <p class="text-xs text-slate-500">{t.seoKeywords.join(', ')}</p>
          </>
        )}
      </section>

      <!-- Rail sticky del slot "side": comparte columna con el contenido SEO/FAQ real de
           arriba (mismo texto en todas las herramientas), así no requiere copy nueva por tool. -->
      <aside class="hidden lg:block" aria-label="Advertisement">
        <div class="sticky top-20">
          <AdSlot position="side" size="rectangle" client:idle={{ timeout: 2000 }} />
        </div>
      </aside>
    </div>

    {/* Footer renderizado aquí (tras CTAs, relacionadas y contenido SEO)
        para que quede al final real de la página, no dentro de la isla */}
    {tool === 'compresssnap' && <CompressFooter lang={castLang} t={dictionary} client:load />}
    {tool === 'backgroundremover' && <BgRemoverFooter lang={castLang} t={dictionary} client:load />}
    {tool === 'pdf-flow' && <PdfFlowFooter lang={castLang} t={dictionary} client:load />}

    <CookieBanner lang={castLang} client:load />
  </body>
</html>

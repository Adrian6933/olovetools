          box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
        }

        .checkered-bg {
          background-image: linear-gradient(45deg, #110e19 25%, transparent 25%),
                            linear-gradient(-45deg, #110e19 25%, transparent 25%),
                            linear-gradient(45deg, transparent 75%, #110e19 75%),
                            linear-gradient(-45deg, transparent 75%, #110e19 75%);
          background-size: 20px 20px;
          background-position: 0 0, 0 10px, 10px -10px, -10px 0px;
          background-color: #060408;

        .glow-red { box-shadow: 0 0 25px -5px rgba(239, 68, 68, 0.35); }
      </style>
    )}

    {tool === 'recordsnap' && (
      <style is:inline>
        body {
          background-color: #0b0805 !important;
          background-image: radial-gradient(circle at 50% -25%, #2a1b0a 0%, #0b0805 50%) !important;
          background-attachment: fixed !important;

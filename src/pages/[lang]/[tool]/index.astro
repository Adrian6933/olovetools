import KeyDoctor from '../../../tools/key-doctor/KeyDoctor';
import WhiteboardFlow from '../../../tools/whiteboard-flow/WhiteboardFlow';
import SubtitlesBolt from '../../../tools/subtitles-bolt/SubtitlesBolt';
import Passbolt from '../../../tools/passbolt/Passbolt';
import WhoisBolt from '../../../tools/whois-bolt/WhoisBolt';
import Framesnap from '../../../tools/framesnap/Framesnap';
import Cleansnap from '../../../tools/cleansnap/Cleansnap';
import Klipy from '../../../tools/klipy/Klipy';
import ClipFlow from '../../../tools/clip-flow/ClipFlow';
import JwtBolt from '../../../tools/jwt-bolt/JwtBolt';
import QrReader from '../../../tools/qr-reader/QrReader';
import { Footer as CompressFooter } from '../../../tools/compresssnap/components/Footer';
import { Footer as BgRemoverFooter } from '../../../tools/backgroundremover/components/Footer';
import { Footer as PdfFlowFooter } from '../../../tools/pdf-flow/components/Footer';
import { CookieBanner } from '../../../components/CookieBanner';
import { ToolPlaceholder } from '../../../components/ToolPlaceholder';
import { AdRail } from '../../../components/shared/AdRail';
import { AdSlot } from '../../../components/shared/AdSlot';
import { RELATED_TOOLS } from '../../../config/related-tools';
import { TOOL_CTAS, CTA_HEADING } from '../../../config/tool-ctas';
import { useTranslation, Language } from '../../../locales/dictionary';
import { ClientRouter } from 'astro:transitions';
import { TOOL_FAVICONS, TOOL_THEME_COLORS } from '../../../constants';
import Analytics from '../../../components/Analytics.astro';
import '../../../styles/global.css';

export const prerender = true;

export function getStaticPaths() {
  const tools = ['clipy', 'twitchbolt', 'kickbolt', 'formatflow', 'pastesnap', 'compresssnap', 'backgroundremover', 'pdf-flow', 'recordsnap', 'qr-bolt', 'codecard', 'cropsnap', 'css-designer', 'json-flow', 'socialbolt', 'tts-bolt', 'gif-bolt', 'audiosnap', 'drawsnap', 'diffsnap', 'watermark-snap', 'favicon-bolt', 'exif-clear', 'meme-bolt', 'wordflow', 'markdown-live', 'hash-bolt', 'zip-flow', 'regex-flow', 'lottie-viewer', 'svg-optimizer', 'graph-flow', 'url-bolt', 'base64-bolt', 'uuid-generator', 'list-mixer', 'html-sanitizer', 'colorsnap', 'hex-to-rgb', 'aspect-ratio', 'unitflow', 'sql-flow', 'cron-flow', 'xml-json', 'binary-flow', 'morse-flow', 'epoch-flow', 'time-bolt', 'device-test', 'lorem-flow', 'key-doctor', 'whiteboard-flow', 'subtitles-bolt', 'passbolt', 'whois-bolt', 'framesnap', 'cleansnap', 'klipy', 'clip-flow', 'jwt-bolt', 'qr-reader'];
  const languages = ['en', 'es', 'fr', 'de', 'pt', 'ru', 'hi', 'ja', 'zh'];
  
  return tools.flatMap(tool => 
    languages.map(lang => ({
      params: { lang, tool },
    }))
  );
}

const { lang, tool } = Astro.params;
const castLang = lang as Language;
const { t, dictionary } = useTranslation(castLang, tool as any);

const langs = ['en', 'es', 'fr', 'de', 'pt', 'ru', 'hi', 'ja', 'zh'];
const baseUrl = 'https://olovetools.com';

const currentFavicon = TOOL_FAVICONS[tool] || TOOL_FAVICONS.default;
const currentThemeColor = TOOL_THEME_COLORS[tool] || TOOL_THEME_COLORS.default;

// Standardize title: ToolName | Short Description
const toolNames: Record<string, string> = {
  clipy: 'Clipy',
  klipy: 'Klipy',
  twitchbolt: 'TwitchBolt',
  kickbolt: 'KickBolt',
  'clip-flow': 'ClipFlow',
  formatflow: 'FormatFlow',
  pastesnap: 'PasteSnap',
  compresssnap: 'CompressSnap',
  backgroundremover: 'Background Remover',
  recordsnap: 'RecordSnap',
  codecard: 'CodeCard',
  cropsnap: 'CropSnap',
  socialbolt: 'SocialBolt',
  audiosnap: 'AudioSnap',
  drawsnap: 'DrawSnap',
  diffsnap: 'DiffSnap',
  wordflow: 'WordFlow',
  colorsnap: 'ColorSnap',
  unitflow: 'UnitFlow',
  passbolt: 'PassBolt',
  framesnap: 'FrameSnap',
  cleansnap: 'CleanSnap',
  'pdf-flow': 'PDFFlow',
  'qr-bolt': 'QRBolt',
  'css-designer': 'CSS Designer',
  'json-flow': 'JSONFlow',
  'tts-bolt': 'TTSBolt',
  'gif-bolt': 'GIFBolt',
  'watermark-snap': 'WatermarkSnap',
  'favicon-bolt': 'FaviconBolt',
  'exif-clear': 'EXIF Cleaner',
  'meme-bolt': 'MemeBolt',
  'markdown-live': 'MarkdownLive',
  'hash-bolt': 'HashBolt',
  'zip-flow': 'ZipFlow',
  'regex-flow': 'RegexFlow',
  'lottie-viewer': 'Lottie Viewer',
  'svg-optimizer': 'SVG Optimizer',
  'graph-flow': 'GraphFlow',
  'url-bolt': 'URLBolt',
  'base64-bolt': 'Base64Bolt',
  'uuid-generator': 'UUID Generator',
  'list-mixer': 'List Mixer',
  'html-sanitizer': 'HTML Sanitizer',
  'hex-to-rgb': 'Hex to RGB',
  'aspect-ratio': 'Aspect Ratio',
  'sql-flow': 'SQLFlow',
  'cron-flow': 'CronFlow',
  'xml-json': 'XML to JSON',
  'binary-flow': 'BinaryFlow',
  'morse-flow': 'MorseFlow',
  'epoch-flow': 'EpochFlow',
  'time-bolt': 'TimeBolt',
  'device-test': 'Device Test',
  'lorem-flow': 'LoremFlow',
  'key-doctor': 'Key Doctor',
  'whiteboard-flow': 'WhiteboardFlow',
  'subtitles-bolt': 'SubtitlesBolt',
  'whois-bolt': 'WhoisBolt',
  'jwt-bolt': 'JWTBolt'  , 'qr-reader': 'QR Reader'


};
const name = toolNames[tool as string] || ((tool as string).charAt(0).toUpperCase() + (tool as string).slice(1));
let seoTitle = t('seo_title');
seoTitle = seoTitle.replace(/^oLoveTools\s*[|\-]\s*/gi, '');
const finalTitle = seoTitle.toLowerCase().includes(name.toLowerCase())
  ? seoTitle
  : `${name} | ${seoTitle}`;

// ---- Herramientas relacionadas (enlazado interno SSR, fuera de la isla React) ----
const RELATED_HEADING: Record<string, string> = {
  en: 'Related tools', es: 'Herramientas relacionadas', fr: 'Outils similaires',
  de: 'Ähnliche Tools', pt: 'Ferramentas relacionadas', ru: 'Похожие инструменты',
  hi: 'संबंधित उपकरण', ja: '関連ツール', zh: '相关工具',
};
const relatedSlugs = (RELATED_TOOLS[tool as string] || []).slice(0, 6);
const relatedHeading = RELATED_HEADING[castLang] || RELATED_HEADING.en;

// ---- CTAs cruzados: botones "siguiente paso" hacia herramientas que continúan el flujo ----
const toolCtas = TOOL_CTAS[tool as string] || [];
const ctaHeading = CTA_HEADING[castLang] || CTA_HEADING.en;

// ---- SEO: structured data + rich meta sources ----
const faqItems: Array<{ question: string; answer: string }> = Array.isArray((dictionary as any)?.faq) ? (dictionary as any).faq : [];
const seoKeywords: string[] = Array.isArray((dictionary as any)?.seoKeywords) ? (dictionary as any).seoKeywords : [];
const ogLocaleMap: Record<string, string> = { en: 'en_US', es: 'es_ES', fr: 'fr_FR', de: 'de_DE', pt: 'pt_BR', ru: 'ru_RU', hi: 'hi_IN', ja: 'ja_JP', zh: 'zh_CN' };
const currentOgLocale = ogLocaleMap[lang as string] || 'en_US';
// Trailing slash: Apache sirve /{lang}/{tool}/ (301 desde la versión sin barra),
// y el sitemap generado usa barra final — canonical/hreflang/og deben coincidir.
const toolUrl = `${baseUrl}/${lang}/${tool}/`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "oLoveTools", "item": `${baseUrl}/${lang}/` },
    { "@type": "ListItem", "position": 2, "name": name, "item": toolUrl }
  ]
};

const faqSchema = faqItems.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": { "@type": "Answer", "text": f.answer }
  }))
} : null;

const appSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": name,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Runs entirely in the browser.",
  "description": t('seo_description'),
  "url": toolUrl,
  "inLanguage": lang,
  "image": `${baseUrl}/og-${tool}.png`,
  "isAccessibleForFree": true,
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "publisher": { "@type": "Organization", "name": "oLoveTools", "url": baseUrl }
};

---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{finalTitle}</title>
    <meta property="og:title" content={finalTitle} />
    <meta name="twitter:title" content={finalTitle} />
    <ClientRouter />
    <meta name="description" content={t('seo_description')} />
    <meta property="og:description" content={t('seo_description')} />
    <meta property="og:url" content={toolUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${baseUrl}/og-${tool}.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:description" content={t('seo_description')} />
    <meta name="twitter:image" content={`${baseUrl}/og-${tool}.png`} />
    <link rel="canonical" href={toolUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="author" content="oLoveTools" />
    {seoKeywords.length > 0 && <meta name="keywords" content={seoKeywords.join(', ')} />}
    <meta property="og:site_name" content="oLoveTools" />
    <meta property="og:locale" content={currentOgLocale} />
    {langs.filter(l => l !== lang).map(l => (
      <meta property="og:locale:alternate" content={ogLocaleMap[l] || l} />
    ))}
    <meta name="twitter:site" content="@olovetools" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <meta name="google-adsense-account" content="ca-pub-4601581729676999">
    <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4601581729676999" crossorigin="anonymous"></script>
    
    <link rel="icon" type={currentFavicon.endsWith('.svg') ? 'image/svg+xml' : 'image/png'} href={currentFavicon}>
    <link rel="apple-touch-icon" href="/icon.svg">
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content={currentThemeColor} />
    
    <!-- Preconnect to Google Fonts for faster font loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"></noscript>
    
    {tool === 'clipy' && (
      <>
        <link rel="preconnect" href="https://api.twitch.tv" crossorigin />
        <link rel="preconnect" href="https://id.twitch.tv" crossorigin />
        <link rel="preconnect" href="https://static-cdn.jtvnw.net" />
      </>
    )}

    {langs.map(l => (
      <link rel="alternate" hreflang={l} href={`${baseUrl}/${l}/${tool}/`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${baseUrl}/en/${tool}/`} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(appSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
    {faqSchema && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />}
    {tool === 'clipy' && (
      <style is:inline>
        body { 
          background: radial-gradient(circle at top center, #100a1f 0%, #050507 100%) !important;
          background-attachment: fixed !important;
          color: #efeff1 !important; 
          font-family: 'Plus Jakarta Sans', sans-serif !important; 
          overflow-x: hidden !important;
          width: 100% !important;
        }
        body::before {
          content: "";
          position: fixed;
          top: 0; left: 0; width: 100%; height: 100%;
          background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
          opacity: 0.01;
          pointer-events: none;
          z-index: 100;
        }
        #root { min-height: 100vh; position: relative; z-index: 10; }
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #050507; }
        ::-webkit-scrollbar-thumb { background: rgba(145, 70, 255, 0.4); border-radius: 10px; border: 2px solid #050507; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(145, 70, 255, 0.6); }

        /* ANIMACIONES EXCLUSIVAS PARA CLIPY */
        @keyframes rotate-continuous { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
        .animate-rotate-slow { animation: rotate-continuous 12s linear infinite; }
        .transition-premium { transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1); }

        .custom-scrollbar::-webkit-scrollbar { height: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.1); border-radius: 10px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(145, 70, 255, 0.5); }
        .custom-scrollbar { scrollbar-width: thin; scrollbar-color: rgba(255, 255, 255, 0.1) transparent; }
        
        .glass {
          background: rgba(255, 255, 255, 0.03);
          backdrop-filter: blur(10px);
          -webkit-backdrop-filter: blur(10px);
        }
      </style>
    )}

    {tool === 'twitchbolt' && (
      <style is:inline>
        body {
          background-color: #070708 !important;
          background-image: radial-gradient(circle at 50% -25%, #110b22 0%, #070708 50%) !important;
          background-attachment: fixed !important;
          color: #efeff1 !important;
          font-family: 'Outfit', sans-serif !important;
          min-height: 100vh !important;
          overflow-x: hidden !important;
          width: 100% !important;
        }
        #root { min-height: 100vh; position: relative; z-index: 10; }
        ::-webkit-scrollbar { width: 10px; }
        ::-webkit-scrollbar-track { background: #0e0e10; }
        ::-webkit-scrollbar-thumb { background: #2f2f35; border-radius: 5px; border: 2px solid #0e0e10; }
        ::-webkit-scrollbar-thumb:hover { background: #9146FF; }
        
        .glass-card {
          background: rgba(24, 24, 27, 0.6);
          backdrop-filter: blur(12px);
          border: 1px solid rgba(255, 255, 255, 0.05);
        }
        .scrollbar-hide::-webkit-scrollbar {
          display: none;
        }
        .scrollbar-hide {
          -ms-overflow-style: none;
          scrollbar-width: none;
        }
      </style>
    )}

    {tool === 'kickbolt' && (
      <style is:inline>
        body {
          background-color: #070708 !important;
          background-image: radial-gradient(circle at 50% -25%, #0a1c0a 0%, #070708 50%) !important;
          background-attachment: fixed !important;
          color: #efeff1 !important;
          font-family: 'Outfit', sans-serif !important;
          min-height: 100vh !important;
          overflow-x: hidden !important;
          width: 100% !important;
        }
        #root { min-height: 100vh; position: relative; z-index: 10; }
        ::-webkit-scrollbar { width: 10px; }
        ::-webkit-scrollbar-track { background: #0e0e10; }
        ::-webkit-scrollbar-thumb { background: #2f2f35; border-radius: 5px; border: 2px solid #0e0e10; }
        ::-webkit-scrollbar-thumb:hover { background: #53FC18; }
        
        .glass-card {
          background: rgba(24, 24, 27, 0.6);
          backdrop-filter: blur(12px);
          border: 1px solid rgba(255, 255, 255, 0.05);
        }
        .scrollbar-hide::-webkit-scrollbar {
          display: none;
        }
        .scrollbar-hide {
          -ms-overflow-style: none;
          scrollbar-width: none;
        }
      </style>
    )}

    {tool === 'formatflow' && (
      <style is:inline>
        body {
          background-color: #080c14 !important;
          color: #e2e8f0 !important;
          min-height: 100vh !important;
          overflow-x: hidden !important;
          width: 100% !important;
        }
        #root { min-height: 100vh; position: relative; z-index: 10; }
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #080c14; }
        ::-webkit-scrollbar-thumb { background: #312e81; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #4338ca; }
        
        .glass-card {
          background: rgba(17, 24, 39, 0.4);
          backdrop-filter: blur(16px);
          -webkit-backdrop-filter: blur(16px);
          border: 1px solid rgba(255, 255, 255, 0.08);
          box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
        }
        
        input[type=range] { -webkit-appearance: none; background: transparent; }
        input[type=range]::-webkit-slider-thumb {
          -webkit-appearance: none; height: 20px; width: 20px; border-radius: 50%;
          background: #ffffff; cursor: pointer; margin-top: -9px;
          box-shadow: 0 0 10px rgba(0,0,0,0.5); border: 2px solid currentColor;
        }
        input[type=range]::-webkit-slider-runnable-track {
          width: 100%; height: 4px; cursor: pointer;
          background: rgba(255,255,255,0.1); border-radius: 2px;
        }
        
        .stagger-1 { animation-delay: 0.1s; }
        .stagger-2 { animation-delay: 0.2s; }
        .stagger-3 { animation-delay: 0.3s; }
        
        .glow-primary { box-shadow: 0 0 20px -5px rgba(99, 102, 241, 0.3); }
        .glow-secondary { box-shadow: 0 0 20px -5px rgba(168, 85, 247, 0.3); }
      </style>
    )}

    {tool === 'pastesnap' && (
      <style is:inline>
        body { margin: 0; background-color: #04050a !important; color: #f3f4f6 !important; min-height: 100vh !important; font-family: 'Plus Jakarta Sans', sans-serif !important; overflow-x: hidden !important; width: 100% !important; }
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #04050a; }
        ::-webkit-scrollbar-thumb { background: #4f46e5; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #6366f1; }
        html { scroll-behavior: smooth; }
        .glass-card { background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.05); }
        .text-glow { text-shadow: 0 0 30px rgba(99, 102, 241, 0.6), 0 0 60px rgba(79, 70, 229, 0.4); }
        @keyframes custom-pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.8; transform: scale(1.05); } }
        .animate-fast-pulse { animation: custom-pulse 8s ease-in-out infinite; }
        @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
        .animate-float { animation: float 6s ease-in-out infinite; }
      </style>
    )}

    {tool === 'compresssnap' && (
      <style is:inline>
        body {
          background-color: #060b11 !important;
          color: #e2e8f0 !important;
          min-height: 100vh !important;
          overflow-x: hidden !important;
          width: 100% !important;
        }
        #root { min-height: 100vh; position: relative; z-index: 10; }
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #060b11; }
        ::-webkit-scrollbar-thumb { background: #0f766e; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #0d9488; }
        
        .glass-card {

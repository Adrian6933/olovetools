          border: 1px solid rgba(255, 255, 255, 0.06);
          box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
        }
        
        .glow-amber { box-shadow: 0 0 25px -5px rgba(245, 158, 11, 0.35); }
      </style>
    )}

    {tool === 'qr-bolt' && (
      <style is:inline>
        body {
          background-color: #050907 !important;
          background-image: radial-gradient(circle at 50% -25%, #092317 0%, #050907 50%) !important;
          background-attachment: fixed !important;
          color: #e2e8f0 !important;
          min-height: 100vh !important;
          overflow-x: hidden !important;
          width: 100% !important;
        }
        #root { min-height: 100vh; position: relative; z-index: 10; }
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #050907; }
        ::-webkit-scrollbar-thumb { background: #059669; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #10b981; }
        
        .glass-card {
          background: rgba(10, 20, 15, 0.45);
          backdrop-filter: blur(16px);

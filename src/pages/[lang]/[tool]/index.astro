    )}

    {tool === 'pdf-flow' && (
      <style is:inline>
        body {
          background-color: #0c0506 !important;
          background-image: radial-gradient(circle at 50% -25%, #2a0b0e 0%, #0c0506 50%) !important;
          background-attachment: fixed !important;

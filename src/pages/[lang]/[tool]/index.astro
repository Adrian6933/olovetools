        ::-webkit-scrollbar-thumb { background: #0891b2; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #06b6d4; }
        
        .glass-card {
          background: rgba(3, 15, 20, 0.45);
          backdrop-filter: blur(16px);
          -webkit-backdrop-filter: blur(16px);
          border: 1px solid rgba(255, 255, 255, 0.06);
          box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
        }
        
        .glow-cyan { box-shadow: 0 0 25px -5px rgba(6, 182, 212, 0.35); }
      </style>
    )}
    {tool === 'graph-flow' && (
      <style is:inline>
        body {
          background-color: #0a0804 !important;
          background-image: radial-gradient(circle at 50% -25%, #1a1005 0%, #0a0804 60%) !important;
          background-attachment: fixed !important;
          color: #fef3c7 !important;
          min-height: 100vh !important;
          overflow-x: hidden !important;
          width: 100% !important;
        }
        #root { min-height: 100vh; position: relative; z-index: 10; }
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #0a0804; }
        ::-webkit-scrollbar-thumb { background: #d97706; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #f59e0b; }
        
        .glass-card {
          background: rgba(20, 12, 3, 0.45);
          backdrop-filter: blur(16px);
          -webkit-backdrop-filter: blur(16px);
          border: 1px solid rgba(255, 255, 255, 0.06);
          box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
        }
        
        .glow-amber { box-shadow: 0 0 25px -5px rgba(245, 158, 11, 0.35); }
      </style>
    )}
  </head>
  <body>
    <div id="root">
        {tool === 'clipy' && <ClipyApp lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool === 'twitchbolt' && <Twitchbolt lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool === 'kickbolt' && <Kickbolt lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool === 'formatflow' && <Formatflow lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool === 'pastesnap' && <Pastesnap lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool === 'compresssnap' && <Compresssnap lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool === 'backgroundremover' && <Backgroundremover lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool === 'pdf-flow' && <Pdfflow lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool === 'recordsnap' && <Recordsnap lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool === 'qr-bolt' && <Qrbolt lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool === 'codecard' && <Codecard lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool === 'cropsnap' && <Cropsnap lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool === 'css-designer' && <CSSDesigner lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool === 'json-flow' && <JSONFlow lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool === 'socialbolt' && <SocialBolt lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool === 'tts-bolt' && <TTSBolt lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool === 'gif-bolt' && <GIFBolt lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool === 'audiosnap' && <AudioSnap lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool === 'drawsnap' && <DrawSnap lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool === 'diffsnap' && <DiffSnap lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool === 'watermark-snap' && <WatermarkSnap lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool === 'favicon-bolt' && <FaviconBolt lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool === 'exif-clear' && <EXIFClear lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool === 'meme-bolt' && <MemeBolt lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool === 'wordflow' && <WordFlow lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool === 'markdown-live' && <MarkdownLive lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool === 'hash-bolt' && <HashBolt lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool === 'zip-flow' && <ZipFlow lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool === 'regex-flow' && <RegexFlow lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool === 'lottie-viewer' && <LottieViewer lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool === 'svg-optimizer' && <SVGOptimizer lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool === 'graph-flow' && <GraphFlow lang={castLang} dictionary={dictionary} client:load transition:persist />}
        {tool !== 'clipy' && tool !== 'twitchbolt' && tool !== 'kickbolt' && tool !== 'formatflow' && tool !== 'pastesnap' && tool !== 'compresssnap' && tool !== 'backgroundremover' && tool !== 'pdf-flow' && tool !== 'recordsnap' && tool !== 'qr-bolt' && tool !== 'codecard' && tool !== 'cropsnap' && tool !== 'css-designer' && tool !== 'json-flow' && tool !== 'socialbolt' && tool !== 'tts-bolt' && tool !== 'gif-bolt' && tool !== 'audiosnap' && tool !== 'drawsnap' && tool !== 'diffsnap' && tool !== 'watermark-snap' && tool !== 'favicon-bolt' && tool !== 'exif-clear' && tool !== 'meme-bolt' && tool !== 'wordflow' && tool !== 'markdown-live' && tool !== 'hash-bolt' && tool !== 'zip-flow' && tool !== 'regex-flow' && tool !== 'lottie-viewer' && tool !== 'svg-optimizer' && tool !== 'graph-flow' && (
          <div class="min-h-screen bg-[#060609] text-slate-200 font-sans">
             <ToolPlaceholder lang={castLang} toolSlug={tool!} client:load />
          </div>
        )}
    </div>

    <!-- SSR SEO Content for AdSense Approval -->
    <div class="hidden-seo-content" style="display: none;" aria-hidden="true">
      <h1>{finalTitle}</h1>
      <p>{t('seo_description')}</p>
      
      {/* Usar llaves que realmente existen en el diccionario para Clipy y otros */}
      {t('footer_seo_title') && <h2>{t('footer_seo_title')}</h2>}
      {t('footer_seo_paragraph1') && <p>{t('footer_seo_paragraph1')}</p>}
      {t('footer_seo_paragraph2') && <p>{t('footer_seo_paragraph2')}</p>}
      {t('footer_seo_desc_large') && <p>{t('footer_seo_desc_large')}</p>}

      {/* Solo intentar mapear si t.faq es realmente un array */}
      {Array.isArray(t.faq) && (
        <>
          <h2>{t('faqTitle') || 'FAQ'}</h2>
          {t.faq.map((item: any) => (
            <div>
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </div>
          ))}
        </>
      )}

      {/* Solo intentar unir si t.seoKeywords es realmente un array */}
      {Array.isArray(t.seoKeywords) && (
        <>
          <h2>{t('seoKeywordsTitle') || 'Keywords'}</h2>
          <p>{t.seoKeywords.join(', ')}</p>
        </>
      )}
    </div>
    <CookieBanner lang={castLang} client:load />
  </body>
</html>

---
import LegalLayout from '../../../layouts/LegalLayout.astro';
import { legalTranslations } from '../../../locales/legal/index';

export function getStaticPaths() {
  const languages = ['en', 'es', 'fr', 'de', 'pt', 'ru', 'hi', 'ja', 'zh'];
  return languages.map(lang => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
const t = legalTranslations[lang as string] || legalTranslations.en;
const privacy = t.privacy;
---

<LegalLayout title={privacy.title} description={privacy.description} lang={lang!}>
  <Fragment set:html={privacy.content} />
</LegalLayout>

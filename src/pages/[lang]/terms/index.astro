---
import LegalLayout from '../../../layouts/LegalLayout.astro';
import { legalTranslations } from '../../../locales/legal/index';

export function getStaticPaths() {
  const languages = ['en', 'es', 'fr', 'de', 'pt', 'ru', 'hi', 'ja', 'zh'];
  return languages.map(lang => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
const t = legalTranslations[lang as string] || legalTranslations.en;
const terms = t.terms;
---

<LegalLayout title={terms.title} description={terms.description} lang={lang!}>
  <h1 class="text-4xl font-bold text-white mb-8 font-outfit">{terms.title}</h1>
  <div class="prose prose-invert max-w-none space-y-6 text-lg" set:html={terms.content} />
</LegalLayout>

---
import { Home } from '../../components/Home';
import { CookieBanner } from '../../components/CookieBanner';
import { useTranslation, Language } from '../../locales/dictionary';
import { ClientRouter } from 'astro:transitions';
import Analytics from '../../components/Analytics.astro';
import '../../styles/global.css';

export function getStaticPaths() {
  const languages = ['en', 'es', 'fr', 'de', 'pt', 'ru', 'hi', 'ja', 'zh'];
  return languages.map(lang => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
const castLang = lang as Language;
const { t, dictionary } = useTranslation(castLang, 'hub');

const langs = ['en', 'es', 'fr', 'de', 'pt', 'ru', 'hi', 'ja', 'zh'];
const baseUrl = 'https://olovetools.com';

const ogLocaleMap: Record<string, string> = { en: 'en_US', es: 'es_ES', fr: 'fr_FR', de: 'de_DE', pt: 'pt_BR', ru: 'ru_RU', hi: 'hi_IN', ja: 'ja_JP', zh: 'zh_CN' };
const currentOgLocale = ogLocaleMap[lang as string] || 'en_US';

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "oLoveTools",
  "url": `${baseUrl}/${lang}`,
  "inLanguage": lang,
  "description": t('seo_description'),
  "publisher": { "@type": "Organization", "name": "oLoveTools", "url": baseUrl }
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "oLoveTools",
  "url": baseUrl,
  "logo": `${baseUrl}/icon.svg`,
  "description": t('seo_description')
};
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="theme-color" content="#060609" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t('seo_title')}</title>
    <ClientRouter />
    <meta name="description" content={t('seo_description')} />
    <meta property="og:title" content={t('seo_title')} />
    <meta property="og:description" content={t('seo_description')} />
    <meta property="og:url" content={`${baseUrl}/${lang}`} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${baseUrl}/og-image.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t('seo_title')} />
    <meta name="twitter:description" content={t('seo_description')} />
    <meta name="twitter:image" content={`${baseUrl}/og-image.png`} />
    <link rel="canonical" href={`${baseUrl}/${lang}`} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="author" content="oLoveTools" />
    <meta property="og:site_name" content="oLoveTools" />
    <meta property="og:locale" content={currentOgLocale} />
    {langs.filter(l => l !== lang).map(l => (
      <meta property="og:locale:alternate" content={ogLocaleMap[l] || l} />
    ))}
    <meta name="twitter:site" content="@olovetools" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <meta name="google-adsense-account" content="ca-pub-4601581729676999">
    <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4601581729676999" crossorigin="anonymous"></script>
    
    <link rel="icon" type="image/svg+xml" href="/icon.svg">
    <link rel="apple-touch-icon" href="/icon.svg">
    <link rel="manifest" href="/manifest.json">

    <!-- Preconnect to Google Fonts for faster font loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"></noscript>
    
    {langs.map(l => (
      <link rel="alternate" hreflang={l} href={`${baseUrl}/${l}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${baseUrl}/en`} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "oLoveTools Collection",
      "applicationCategory": "BrowserApplication",
      "operatingSystem": "All",
      "description": t('seo_description'),
      "url": `${baseUrl}/${lang}`
    })} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationSchema)} />
    
    <style is:global>
      /* Reset leaking styles from other pages */
      body {
        background-image: none !important;
        background-attachment: scroll !important;
        background-color: #060609 !important;
        margin: 0;
        overflow-x: hidden !important;
        width: 100% !important;
      }
      body::before {
        display: none !important;
      }
    </style>
    <Analytics />
  </head>
  <body class="bg-[#060609]">
    <Home lang={lang || 'en'} dictionary={dictionary} client:load />

    <script is:inline>
      // Force scroll to top on view transitions
      document.addEventListener('astro:after-navigation', () => {
        window.scrollTo(0, 0);
      });
    </script>
    <CookieBanner lang={castLang} client:load />
  </body>
</html>

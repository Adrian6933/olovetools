---
// Server-side language redirect (replaces the old Apache/.htaccess
// Accept-Language rule from the Hostinger deployment, now that hosting is
// Vercel). Not prerendered — needs to run per-request to read the header.
// A server redirect avoids the "avoid client-side redirects" PageSpeed/
// Lighthouse warning that a pure client-side JS redirect would trigger.
export const prerender = false;

const SUPPORTED_LANGS = ['en', 'es', 'fr', 'de', 'pt', 'ru', 'hi', 'ja', 'zh'];

function pickLang(acceptLanguage: string | null): string {
  if (!acceptLanguage) return 'en';
  const primary = acceptLanguage.split(',')[0]?.split('-')[0]?.toLowerCase();
  return primary && SUPPORTED_LANGS.includes(primary) ? primary : 'en';
}

const targetLang = pickLang(Astro.request.headers.get('accept-language'));
return Astro.redirect(`/${targetLang}/`, 302);
---

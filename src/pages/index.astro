---
// Redirige el dominio base al idioma detectado o guardado previamente
---
<!DOCTYPE html>
<html>
  <head>
    <title>Redirecting...</title>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <script is:inline>
      // 1. Intentar obtener el idioma guardado previamente
      const savedLang = window.localStorage.getItem('olovetools_lang');
      
      // 2. Idiomas soportados
      const supportedLangs = ['en', 'es', 'fr', 'de', 'pt', 'ru', 'hi', 'ja', 'zh'];
      
      let targetLang;
      if (savedLang && supportedLangs.includes(savedLang)) {
        targetLang = savedLang;
      } else {
        const browserLang = navigator.language.split('-')[0];
        targetLang = supportedLangs.includes(browserLang) ? browserLang : 'en';
      }

      window.location.replace(`/${targetLang}/`);
    </script>
  </body>
</html>

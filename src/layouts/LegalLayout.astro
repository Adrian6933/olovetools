---
import { useTranslation, Language } from '../locales/dictionary';
import { legalTranslations } from '../locales/legal/index';
import { CookieBanner } from '../components/CookieBanner';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang: string;
}

const { title, description, lang } = Astro.props;
const castLang = lang as Language;
const { t } = useTranslation(castLang, 'hub');

const baseUrl = 'https://olovetools.com';
const langs = ['en', 'es', 'fr', 'de', 'pt', 'ru', 'hi', 'ja', 'zh'];
const ogLocaleMap: Record<string, string> = { en: 'en_US', es: 'es_ES', fr: 'fr_FR', de: 'de_DE', pt: 'pt_BR', ru: 'ru_RU', hi: 'hi_IN', ja: 'ja_JP', zh: 'zh_CN' };
const currentOgLocale = ogLocaleMap[lang] || 'en_US';

const navText = legalTranslations[lang]?.nav || legalTranslations['en'].nav;

// Safely generate the correct path for a given language
function getLangUrl(l: string, currentPath: string) {
  const segments = currentPath.split('/').filter(Boolean);
  if (segments.length > 0 && langs.includes(segments[0])) {
    segments[0] = l;
  } else {
    segments.unshift(l);
  }
  return `/${segments.join('/')}`;
}

const canonicalUrl = `${baseUrl}${Astro.url.pathname}`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "oLoveTools", "item": `${baseUrl}/${lang}` },
    { "@type": "ListItem", "position": 2, "name": title, "item": canonicalUrl }
  ]
};
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | oLoveTools</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#06060b" />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="oLoveTools" />
    <ClientRouter />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/icon.svg">
    <link rel="apple-touch-icon" href="/icon.svg">
    <link rel="manifest" href="/manifest.json">
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="oLoveTools" />
    <meta property="og:title" content={`${title} | oLoveTools`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${baseUrl}/og-image.png`} />
    <meta property="og:locale" content={currentOgLocale} />
    {langs.filter(l => l !== lang).map(l => (
      <meta property="og:locale:alternate" content={ogLocaleMap[l] || l} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | oLoveTools`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${baseUrl}/og-image.png`} />

    <meta name="google-adsense-account" content="ca-pub-4601581729676999">
    <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4601581729676999" crossorigin="anonymous"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"></noscript>

    {langs.map(l => (
      <link rel="alternate" hreflang={l} href={`${baseUrl}${getLangUrl(l, Astro.url.pathname)}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${baseUrl}${getLangUrl('en', Astro.url.pathname)}`} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />

    <style is:global>
      body {
        background-color: #06060b !important;
        background-image: radial-gradient(circle at 50% -10%, #15131f 0%, #06060b 55%) !important;
        background-attachment: fixed !important;
      }
      .legal-prose h2 { color: #fff; font-weight: 700; font-size: 1.5rem; margin-top: 2.5rem; margin-bottom: 1rem; letter-spacing: -0.01em; }
      .legal-prose h3 { color: #e5e7eb; font-weight: 600; font-size: 1.15rem; margin-top: 1.75rem; margin-bottom: 0.75rem; }
      .legal-prose p { color: #9ca3af; line-height: 1.8; margin-bottom: 1.1rem; }
      .legal-prose ul { list-style: disc; padding-left: 1.5rem; margin-bottom: 1.1rem; color: #9ca3af; }
      .legal-prose li { margin-bottom: 0.5rem; line-height: 1.7; }
      .legal-prose a { color: #818cf8; text-decoration: underline; text-underline-offset: 3px; }
      .legal-prose a:hover { color: #a5b4fc; }
      .legal-prose strong { color: #e5e7eb; font-weight: 600; }
    </style>
  </head>
  <body class="bg-[#06060b] text-slate-300 font-sans min-h-screen flex flex-col selection:bg-indigo-500/30">
    <!-- Header -->
    <header class="sticky top-0 z-50 border-b border-white/10 bg-[#0b0b12]/90 backdrop-blur-xl">
      <div class="max-w-4xl mx-auto px-6 h-16 flex justify-between items-center gap-4">
        <a href={`/${lang}`} class="flex items-center gap-2.5 group shrink-0">
          <div class="w-9 h-9 bg-indigo-600 rounded-xl flex items-center justify-center group-hover:rotate-6 group-hover:scale-110 transition-transform shadow-lg shadow-indigo-600/30">
            <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" /></svg>
          </div>
          <span class="font-black text-lg tracking-tighter font-outfit"><span class="text-white">oLove</span><span class="text-indigo-400">Tools</span></span>
        </a>

        <div class="relative">
          <select
            id="legal-lang-select"
            class="appearance-none bg-white/5 border border-white/10 hover:border-indigo-500/40 text-slate-200 text-xs font-bold uppercase tracking-wider rounded-xl pl-3 pr-8 py-2 cursor-pointer outline-none transition-colors"
            aria-label="Language"
          >
            {langs.map(l => (
              <option value={getLangUrl(l, Astro.url.pathname)} selected={l === lang} class="bg-[#0b0b12]">{l.toUpperCase()}</option>
            ))}
          </select>
          <svg class="w-4 h-4 absolute right-2 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg>
        </div>
      </div>
    </header>

    <!-- Content -->
    <main class="flex-1 max-w-3xl mx-auto px-6 py-16 md:py-24 w-full">
      <a href={`/${lang}`} class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-slate-500 hover:text-indigo-400 transition-colors mb-10">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        {navText.home || 'Home'}
      </a>

      <article class="bg-white/[0.02] border border-white/5 rounded-3xl p-8 md:p-12 shadow-2xl">
        <h1 class="text-3xl md:text-4xl font-black text-white mb-2 font-outfit tracking-tight">{title}</h1>
        <p class="text-sm text-slate-500 mb-8 border-b border-white/5 pb-8">{description}</p>
        <div class="legal-prose max-w-none"><slot /></div>
      </article>
    </main>

    <!-- Footer -->
    <footer class="border-t border-white/10 bg-[#0b0b12] py-12 text-center text-sm text-slate-500">
      <div class="max-w-4xl mx-auto px-6 space-y-5">
        <a href={`/${lang}`} class="inline-flex items-center gap-2 group">
          <span class="font-black text-base tracking-tighter font-outfit"><span class="text-white group-hover:text-indigo-400 transition-colors">oLove</span><span class="text-indigo-400">Tools</span></span>
        </a>
        <div class="flex flex-wrap justify-center gap-x-6 gap-y-2">
          <a href={`/${lang}/privacy`} class="hover:text-indigo-400 transition-colors">{navText.privacy}</a>
          <a href={`/${lang}/terms`} class="hover:text-indigo-400 transition-colors">{navText.terms}</a>
          <a href={`/${lang}/cookies`} class="hover:text-indigo-400 transition-colors">{navText.cookies}</a>
          <a href={`/${lang}/about`} class="hover:text-indigo-400 transition-colors">{navText.about}</a>
        </div>
        <p class="text-xs text-slate-600">&copy; {new Date().getFullYear()} oLoveTools. All rights reserved.</p>
      </div>
    </footer>

    <CookieBanner lang={castLang} client:load />

    <script is:inline>
      document.getElementById('legal-lang-select')?.addEventListener('change', (e) => {
        const v = e.target.value;
        if (v) window.location.href = v;
      });
    </script>
  </body>
</html>

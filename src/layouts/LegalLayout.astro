---
import { useTranslation, Language, LANGUAGE_NAMES } from '../locales/dictionary';
import { legalTranslations } from '../locales/legal/index';
import { CookieBanner } from '../components/CookieBanner';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang: string;
}

const { title, description, lang } = Astro.props;
const castLang = lang as Language;
const { t } = useTranslation(castLang, 'hub');

const baseUrl = 'https://olovetools.com';
const langs = ['en', 'es', 'fr', 'de', 'pt', 'ru', 'hi', 'ja', 'zh'];

const navText = legalTranslations[lang]?.nav || legalTranslations['en'].nav;

// Safely generate the correct path for a given language
function getLangUrl(l: string, currentPath: string) {
  // Path usually looks like /en/privacy or /es/terms
  const segments = currentPath.split('/').filter(Boolean);
  if (segments.length > 0 && langs.includes(segments[0])) {
    segments[0] = l;
  } else {
    segments.unshift(l);
  }
  return `/${segments.join('/')}`;
}
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | oLoveTools</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#060609" />
    <ClientRouter />
    <link rel="icon" type="image/svg+xml" href="/icon.svg">
    <meta name="google-adsense-account" content="ca-pub-4601581729676999">
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4601581729676999" crossorigin="anonymous"></script>
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    {langs.map(l => (
      <link rel="alternate" hreflang={l} href={`${baseUrl}${getLangUrl(l, Astro.url.pathname)}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${baseUrl}${getLangUrl('en', Astro.url.pathname)}`} />
  </head>
  <body class="bg-[#060609] text-slate-300 font-sans min-h-screen flex flex-col">
    <nav class="border-b border-white/10 bg-[#121216] py-4">
      <div class="max-w-4xl mx-auto px-6 flex justify-between items-center">
        <a href={`/${lang}`} class="text-white font-bold text-xl font-outfit">oLoveTools</a>
        <div class="flex gap-4">
           {langs.map(l => (
             <a href={getLangUrl(l, Astro.url.pathname)} class={`text-xs uppercase ${l === lang ? 'text-indigo-400 font-bold' : 'text-slate-500 hover:text-white transition-colors'}`}>{l}</a>
           ))}
        </div>
      </div>
    </nav>

    <main class="flex-1 max-w-4xl mx-auto px-6 py-20 w-full">
      <slot />
    </main>

    <footer class="border-t border-white/10 bg-[#121216] py-12 text-center text-sm text-slate-500">
      <div class="max-w-4xl mx-auto px-6 space-y-4">
        <p>&copy; {new Date().getFullYear()} oLoveTools. All rights reserved.</p>
        <div class="flex justify-center gap-6">
          <a href={`/${lang}/privacy`} class="hover:text-white transition-colors">{navText.privacy}</a>
          <a href={`/${lang}/terms`} class="hover:text-white transition-colors">{navText.terms}</a>
          <a href={`/${lang}/cookies`} class="hover:text-white transition-colors">{navText.cookies}</a>
          <a href={`/${lang}/about`} class="hover:text-white transition-colors">{navText.about}</a>
        </div>
      </div>
    </footer>
    <CookieBanner lang={castLang} client:load />
  </body>
</html>

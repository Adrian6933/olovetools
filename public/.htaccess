# ==============================================================================
# HTAccess Optimizado para Astro y Hostinger (SEO, WPO y Seguridad)
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # 1. Redirección en un solo salto (Evita doble redirección)
    # Redirige cualquier tráfico con "www." y/o en HTTP
    # directamente a la versión HTTPS y SIN "www."
    RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC,OR]
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} ^(?:www\.)?(.*)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>


# 2. Declaración explícita de MIME Types (Garantiza lectura de servidores)
<IfModule mod_mime.c>
    AddType font/woff2 .woff2
    AddType font/woff .woff
    AddType image/webp .webp
    AddType image/svg+xml .svg
</IfModule>


# 3. Compresión GZIP / DEFLATE para mejorar velocidad (Vital para el WPO/SEO)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml font/woff2
</IfModule>


# 4. Caché del navegador para estáticos
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Imágenes, iconos y fuentes: cachés de 1 año (rara vez cambian)
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    
    # CSS y JS: caché de 1 año (Astro siempre hashea los archivos nuevos, es seguro cachear a largo plazo)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    
    # HTML: No cachearlo a largo plazo para asegurar que el contenido esté actualizado
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Forzar Cache-Control de 1 año para archivos inmutables (JS, CSS, Fuentes, WebP)
# Esto sobrescribe configuraciones de algunos servidores que limitan a 7 días.
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|woff|woff2|webp|jpg|jpeg|png|svg|ico)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>
</IfModule>


# ==============================================================================
# CABECERAS Y MEDIDAS DE SEGURIDAD EXTRAS (Imprescindibles)
# ==============================================================================

# 5. Cabeceras de Seguridad Modernas (Puntúan muy alto en auditorías SEO/Seguridad)
<IfModule mod_headers.c>
    # Evita que clonen tu sitio y lo metan dentro de un iFrame (Clickjacking)
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Evita que el navegador adivine el tipo de archivo (Bloquea inyecciones de código malicioso en imágenes)
    Header always set X-Content-Type-Options "nosniff"
    
    # CSP: Prevención de ataques XSS y control de scripts (Permite AdSense)
    # CSP: Prevención de ataques XSS y control total para Google Ads y Fuentes
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.googlesyndication.com https://*.google.com https://*.gstatic.com https://fundingchoicesmessages.google.com https://*.adtrafficquality.google; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.google.com https://*.googlesyndication.com https://*.pagead2.googlesyndication.com; frame-src https://*.google.com https://*.googlesyndication.com https://fundingchoicesmessages.google.com; connect-src 'self' https://*.google.com https://*.googlesyndication.com https://*.adtrafficquality.google; object-src 'none'; upgrade-insecure-requests;"

    # COOP: Mejora el aislamiento del navegador (Recomendado por Google)
    Header always set Cross-Origin-Opener-Policy "same-origin"
    
    # COEP & CORP: Seguridad extra para orígenes cruzados
    Header always set Cross-Origin-Embedder-Policy "unsafe-none"
    Header always set Cross-Origin-Resource-Policy "cross-origin"
</IfModule>


# 6. Prevención de lectura de directorios y datos del servidor
Options -Indexes
ServerSignature Off


# 7. Reglas estrictas de privacidad en archivos sensibles
# Bloquear acceso a este mismo archivo htaccess
<Files .htaccess>
    Order allow,deny
    Deny from all
</Files>

# Prevenir acceso a carpetas de sistema (como .git, .env) si se suben por error
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>


# 8. Página de Error 404 personalizada de Astro
ErrorDocument 404 /404.html

# 9. Redirección de idioma en la raíz (Soluciona el error "Client-side redirect" de PageSpeed)
# Detecta el idioma del navegador y redirige en el servidor (más rápido y mejor SEO)
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_URI} ^/$
    RewriteCond %{HTTP:Accept-Language} ^es [NC]
    RewriteRule ^$ /es/ [L,R=302]

    RewriteCond %{REQUEST_URI} ^/$
    RewriteCond %{HTTP:Accept-Language} ^fr [NC]
    RewriteRule ^$ /fr/ [L,R=302]

    RewriteCond %{REQUEST_URI} ^/$
    RewriteCond %{HTTP:Accept-Language} ^de [NC]
    RewriteRule ^$ /de/ [L,R=302]

    RewriteCond %{REQUEST_URI} ^/$
    RewriteCond %{HTTP:Accept-Language} ^pt [NC]
    RewriteRule ^$ /pt/ [L,R=302]

    RewriteCond %{REQUEST_URI} ^/$
    RewriteCond %{HTTP:Accept-Language} ^ru [NC]
    RewriteRule ^$ /ru/ [L,R=302]

    RewriteCond %{REQUEST_URI} ^/$
    RewriteCond %{HTTP:Accept-Language} ^hi [NC]
    RewriteRule ^$ /hi/ [L,R=302]

    RewriteCond %{REQUEST_URI} ^/$
    RewriteCond %{HTTP:Accept-Language} ^ja [NC]
    RewriteRule ^$ /ja/ [L,R=302]

    RewriteCond %{REQUEST_URI} ^/$
    RewriteCond %{HTTP:Accept-Language} ^zh [NC]
    RewriteRule ^$ /zh/ [L,R=302]

    # Redirección por defecto a inglés si no se detecta ninguno de los anteriores
    RewriteCond %{REQUEST_URI} ^/$
    RewriteRule ^$ /en/ [L,R=302]
</IfModule>
